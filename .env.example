# Copy to .env and edit before the first start:  cp .env.example .env

# --- public address -------------------------------------------------------
# "localhost" makes Caddy issue an internal certificate for local runs.
# In production use your domain, e.g. SITE_ADDRESS=pornhub.singles
SITE_ADDRESS=localhost
# Contact address for Let's Encrypt expiry notices. Optional for local runs;
# set it to a real address before pointing a public domain at this stack.
ACME_EMAIL=

# Canonical URL of the site; used for logging and same-origin checks.
PHS_PUBLIC_URL=https://localhost

# --- admin bootstrap ------------------------------------------------------
# The account is created on first start. Change the password before deploying.
PHS_ADMIN_USERNAME=admin
PHS_ADMIN_PASSWORD=change-me-at-least-8-chars
# Set to true for a single start to reset a forgotten admin password.
PHS_ADMIN_PASSWORD_RESET=false

# --- server ---------------------------------------------------------------
# Session cookie lifetime (Go duration: 30m, 12h, 24h, 168h...).
PHS_SESSION_TTL=24h
# Must stay true in production; only set false when serving plain HTTP locally.
PHS_SECURE_COOKIE=true
# How long one visitor's page view is de-duplicated. Reloading the page inside
# this window does not move the counter.
PHS_VIEW_WINDOW=12h
# Maximum avatar upload size in bytes (2 MiB).
PHS_MAX_UPLOAD_BYTES=2097152
# Extra origins allowed to call the API (comma separated). Empty = same-origin
# only, which is correct when Caddy serves the app and the API on one host.
PHS_CORS_ORIGINS=
# Grace period for in-flight requests on shutdown.
PHS_SHUTDOWN_TIMEOUT=15s

# Note: the landing-page copy, the Verified threshold, maintenance mode and
# search-engine visibility are NOT set here — they live in the owner's Site tab
# so they can be changed without a redeploy.

# --- logging --------------------------------------------------------------
PHS_LOG_LEVEL=info
PHS_LOG_FORMAT=json
